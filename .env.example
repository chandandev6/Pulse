# Postgres
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse_dev_password
POSTGRES_DB=pulse
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://pulse:pulse_dev_password@localhost:5432/pulse
REDIS_URL=redis://localhost:6379
WEB_PUBLIC_URL=http://localhost:5173
# Signs links in notifications. In production: a long random value (openssl rand -base64 48)
APP_SECRET=dev-only-secret-change-me-in-production-please

# Email (F11): Mailpit from docker-compose. Read the emails at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Pulse <alerts@pulse.local>
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# SMS through Twilio (optional: off unless all three are set)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550001111

# Browser push (optional): pnpm --filter @pulse/api exec web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
