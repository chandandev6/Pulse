{
  "name": "pulse",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "worker": "pnpm --filter @pulse/api worker",
    "example": "pnpm --filter @pulse/example-node start",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @pulse/web e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "load-test": "node scripts/load-test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.3",
    "autocannon": "^8.0.0",
    "typescript": "^7.0.2"
  }
}
