# Copy to .env.prod and fill in, then:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# REQUIRED: signs links in notifications. Make one with: openssl rand -base64 48
APP_SECRET=

# Where people and SDKs reach Pulse (the nginx port below, or your domain behind HTTPS)
PUBLIC_URL=http://localhost:8080
# Where nginx listens. 127.0.0.1:8080 = only this machine (behind Cloudflare Tunnel, Caddy…).
# Use 80 (or 0.0.0.0:8080) only if browsers connect to this machine directly.
WEB_PORT=127.0.0.1:8080

# Which bundled services start: local-db (Postgres), local-redis (Redis),
# mailpit (catches email). Using hosted databases or real SMTP? Drop that name.
COMPOSE_PROFILES=local-db,local-redis,mailpit

# The bundled Postgres. Change the password before the first start.
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pulse

# Hosted databases instead (e.g. Neon + Upstash): uncomment both and remove
# local-db / local-redis from COMPOSE_PROFILES above.
# DATABASE_URL=postgres://user:password@ep-xxx.region.aws.neon.tech/pulse?sslmode=require
# REDIS_URL=rediss://default:password@xxx.upstash.io:6379

# Email. The default is the bundled Mailpit (inbox at http://localhost:8025).
# For real email, point these at your provider.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Pulse <alerts@pulse.local>
# SMTP_USER=
# SMTP_PASS=

# Optional: SMS (Twilio) and browser push, see .env.example
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Webhooks may only call public addresses, so nobody can make Pulse reach localhost,
# Redis or the cloud metadata service. Set true only if your webhook receivers are
# on your own private network and you trust every org admin.
# ALLOW_PRIVATE_WEBHOOKS=false

# New accounts must confirm their email before creating projects, channels or invitations.
# This stops strangers using your server to send email/SMS. It needs working email
# (the bundled Mailpit counts: its inbox shows the link). Set false only for a private test.
REQUIRE_EMAIL_VERIFICATION=true

# Ceilings for what org admins can set on their own projects. If strangers can sign up on
# your server, set these, or one free account can fill your database.
# MAX_EVENTS_PER_MINUTE=1000
# MAX_MONTHLY_QUOTA=100000
# MAX_SOURCE_MAP_MB=200

# Pulse reports its own errors (API + worker, and the dashboard) to a Pulse project.
# Use the DSN from that project's Settings page. The web one is baked in at build time.
# PULSE_DSN=https://<key>@pulse.example.com/<project id>
# PULSE_WEB_DSN=https://<key>@pulse.example.com/<project id>
# PULSE_RELEASE=
