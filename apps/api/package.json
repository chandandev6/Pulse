{
  "name": "@pulse/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pulse/shared build && tsx watch --env-file=../../.env src/server.ts",
    "worker": "pnpm --filter @pulse/shared build && tsx watch --env-file=../../.env src/worker.ts",
    "build": "pnpm --filter @pulse/shared build && tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/server.js",
    "start:worker": "node --env-file=../../.env dist/worker.js",
    "typecheck": "pnpm --filter @pulse/shared build && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "pnpm --filter @pulse/shared build && vitest run",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "@pulse/shared": "workspace:*",
    "bullmq": "^6.4.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
